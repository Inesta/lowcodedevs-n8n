{
  "name": "n8n-nodes-lowcodedevs",
  "version": "0.1.0",
  "description": "n8n community nodes for LowCodeDevs: instant lead notifications and portfolio automation for low-code agencies.",
  "keywords": [
    "n8n-community-node-package",
    "lowcodedevs",
    "leads",
    "low-code",
    "agency"
  ],
  "license": "MIT",
  "homepage": "https://lowcodedevs.com/integrations/n8n",
  "repository": {
    "type": "git",
    "url": "https://github.com/lowcodedevs/n8n-nodes-lowcodedevs.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp -r nodes/**/*.svg dist/nodes/ 2>/dev/null || tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LowCodeDevsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LowCodeDevs/LowCodeDevs.node.js",
      "dist/nodes/LowCodeDevsTrigger/LowCodeDevsTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "n8n-workflow": "^1.60.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
